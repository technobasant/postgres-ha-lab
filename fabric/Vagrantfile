# frozen_string_literal: true
# =============================================================================
# Mac ARM host → QEMU TCG x86_64 (amd64) guests + socket_vmnet shared L2
# =============================================================================
# Pattern (vagrant-qemu + socket_vmnet on Apple Silicon):
#   bin/qemu-system-x86_64 closes inherited fds, then execs
#   socket_vmnet_client → real qemu-system-x86_64 so lab NIC gets fd=3.
#   SLIRP net0 stays for Vagrant SSH; extra NIC is shared L2 fabric.
#
# Requirements (once):
#   brew install qemu socket_vmnet
#   vagrant plugin install vagrant-qemu   # >= 0.6.3 recommended
#   sudo /opt/homebrew/opt/socket_vmnet/bin/socket_vmnet \
#     --vmnet-gateway=192.168.105.1 --vmnet-dhcp-end=192.168.105.100 \
#     /opt/homebrew/var/run/socket_vmnet
#
# Why NOT 192.168.1.0/24: that is the most common home Wi‑Fi LAN, and on the
# Mac this was built on, en0 sat in it. Colliding the lab subnet with Wi‑Fi
# breaks ARP/routing.
# =============================================================================

LAB_PREFIX = "192.168.105"
SOCKET = "/opt/homebrew/var/run/socket_vmnet"
CLIENT = "/opt/homebrew/opt/socket_vmnet/bin/socket_vmnet_client"
# Documented path; bin/qemu-system-x86_64 uses the stable Homebrew opt symlink.
REAL_QEMU = "/opt/homebrew/opt/qemu/bin/qemu-system-x86_64"

NODES = [
  { name: "ubuntu1", box: "generic/ubuntu2204", ip: "#{LAB_PREFIX}.111", ssh_port: 22111, memory: "1536", smp: "2", mac: "52:54:00:12:00:11" },
  { name: "ubuntu2", box: "generic/ubuntu2204", ip: "#{LAB_PREFIX}.112", ssh_port: 22112, memory: "1536", smp: "2", mac: "52:54:00:12:00:12" },
  { name: "rocky1",  box: "generic/centos8",    ip: "#{LAB_PREFIX}.121", ssh_port: 22121, memory: "1536", smp: "2", mac: "52:54:00:12:00:21" },
  { name: "rocky2",  box: "generic/centos8",    ip: "#{LAB_PREFIX}.122", ssh_port: 22122, memory: "1536", smp: "2", mac: "52:54:00:12:00:22" },
]

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.box_check_update = false
  config.vm.boot_timeout = 900

  NODES.each do |n|
    config.vm.define n[:name] do |node|
      node.vm.box = n[:box]
      node.vm.hostname = n[:name]

      node.vm.provider "qemu" do |qe|
        qe.arch = "x86_64"
        qe.machine = "q35"
        qe.cpu = "max"
        qe.smp = n[:smp]
        qe.memory = n[:memory]
        qe.ssh_port = n[:ssh_port]
        qe.net_device = "virtio-net-pci" # SLIRP net0 for Vagrant SSH hostfwd
        qe.drive_interface = "virtio"
        qe.qemu_dir = "/opt/homebrew/share/qemu"
        # Do not daemonize: forking drops the socket_vmnet fd inherited as fd=3.
        qe.no_daemonize = true

        # Wrapper closes inherited fds then execs socket_vmnet_client → real QEMU.
        qe.qemu_bin = File.join(File.dirname(__FILE__), "bin", "qemu-system-x86_64")

        # Second NIC: shared lab fabric (host ↔ VM ↔ VM).
        qe.extra_qemu_args = [
          "-device", "virtio-net-pci,netdev=lab0,mac=#{n[:mac]}",
          "-netdev", "socket,id=lab0,fd=3",
        ]
      end

      node.vm.provision "shell", privileged: true, inline: <<-SHELL
        set -euo pipefail
        LAB_IP="#{n[:ip]}"
        LAB_MAC="#{n[:mac]}"

        # Prefer MAC match (stable), else first non-SLIRP NIC.
        IFACE=$(ip -o link | awk -v m="$LAB_MAC" 'BEGIN{IGNORECASE=1} index(tolower($0), tolower(m)){gsub(/:/,"",$2); print $2; exit}')
        if [[ -z "$IFACE" ]]; then
          for i in $(ls /sys/class/net | grep -vE '^(lo|docker|veth|br-)'); do
            ADDR=$(ip -4 -o addr show dev "$i" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 || true)
            [[ "$ADDR" == "10.0.2.15" ]] && continue
            IFACE="$i"
            break
          done
        fi
        [[ -n "$IFACE" ]] || { echo "ERROR: lab NIC not found"; ip -br link; exit 1; }
        echo "Configuring $IFACE ($LAB_MAC) -> $LAB_IP/24"

        if command -v netplan >/dev/null 2>&1; then
          cat >/etc/netplan/99-lab-nic.yaml <<EOF
network:
  version: 2
  ethernets:
    ${IFACE}:
      dhcp4: false
      addresses: [${LAB_IP}/24]
EOF
          chmod 600 /etc/netplan/99-lab-nic.yaml
          netplan apply
        elif command -v nmcli >/dev/null 2>&1; then
          nmcli dev set "$IFACE" managed yes || true
          nmcli con delete "lab-${IFACE}" 2>/dev/null || true
          nmcli con add type ethernet ifname "$IFACE" con-name "lab-${IFACE}" \\
            ipv4.method manual ipv4.addresses "${LAB_IP}/24" \\
            ipv4.never-default yes ipv6.method ignore connection.autoconnect yes
          nmcli con up "lab-${IFACE}"
        else
          ip link set "$IFACE" up
          ip addr flush dev "$IFACE" || true
          ip addr add "${LAB_IP}/24" dev "$IFACE"
        fi

        sleep 1
        ip -br addr
        echo "==> eth1 stats"
        ip -s link show "$IFACE" | head -20
        # macOS vmnet gateway often resolves ARP but does not answer ICMP.
        # Prove L2 with ARP, then leave mesh checks to scripts/verify-mesh.sh.
        echo "==> ARP lab gateway"
        ip neigh flush dev "$IFACE" 2>/dev/null || true
        ping -c 1 -W 1 #{LAB_PREFIX}.1 >/dev/null 2>&1 || true
        ip neigh show dev "$IFACE" | head -5 || true

        cat >/etc/hosts.lab <<'HOSTS'
#{NODES.map { |p| "#{p[:ip]} #{p[:name]}" }.join("\n")}
HOSTS
        while read -r line; do
          grep -qF "$line" /etc/hosts || echo "$line" >> /etc/hosts
        done < /etc/hosts.lab
        mkdir -p /etc/lab
        echo "$LAB_IP" > /etc/lab/ip
        echo "$IFACE" > /etc/lab/iface
        echo "OK #{n[:name]} lab ip $LAB_IP on $IFACE"
      SHELL
    end
  end
end
